# ============================================================================
# Gilbert OS — environment variables (example). Copy to .env.development.local
# for local dev. NEVER commit the filled-in file. On Vercel these are injected
# automatically by the connected integrations (see below) — do not paste secrets
# into the dashboard by hand for anything the integration already provides.
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE — Neon Postgres (REQUIRED)
# ----------------------------------------------------------------------------
# The ONLY database variable the application code reads at runtime is
# DATABASE_URL (see lib/db/index.ts and every scripts/*.mjs). It must be a
# pooled Neon connection string. All the other POSTGRES_*/PG* variables below
# are provisioned by the Neon integration for convenience/compatibility and are
# NOT required by this app — you can ignore them locally if you set DATABASE_URL.
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# Provisioned by the Neon integration (optional / not read by app code):
# DATABASE_URL_UNPOOLED, POSTGRES_URL, POSTGRES_URL_NON_POOLING,
# POSTGRES_URL_NO_SSL, POSTGRES_PRISMA_URL, POSTGRES_HOST, POSTGRES_USER,
# POSTGRES_PASSWORD, POSTGRES_DATABASE, PGHOST, PGHOST_UNPOOLED, PGUSER,
# PGPASSWORD, PGDATABASE, NEON_PROJECT_ID

# ----------------------------------------------------------------------------
# FILE STORAGE — Vercel Blob (REQUIRED for invoice upload)
# ----------------------------------------------------------------------------
# Used by lib/invoice-extraction.ts (`put()`) to retain the original uploaded
# invoice PDF/image before extraction. Provisioned by the Blob integration.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXXXXXX"

# ----------------------------------------------------------------------------
# AI — Vercel AI Gateway (zero-config on Vercel; see notes)
# ----------------------------------------------------------------------------
# The app calls models via the AI SDK (`ai` package) using plain model strings
# ("google/gemini-2.5-flash"). On Vercel the AI Gateway is authenticated
# automatically by OIDC — NO API KEY IS REQUIRED in production.
#
# For LOCAL development the OIDC token is short-lived. Either run the app via
# `vercel dev` (which supplies the token), or set an explicit gateway key:
# AI_GATEWAY_API_KEY="XXXXXXXX"

# ----------------------------------------------------------------------------
# NOT CURRENTLY USED (zero-config / no auth layer)
# ----------------------------------------------------------------------------
# - There is NO application auth (no NEXTAUTH_*, no BETTER_AUTH_*): Gilbert OS
#   currently has no login. Add one before exposing production publicly.
# - NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL exists in the Vercel project env but
#   is NOT used by this codebase (no Supabase integration).
# - No Stripe / payments, no email provider, no third-party API keys are used.
